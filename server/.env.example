# Server Configuration
PORT=5000

# Google Places API (New) - Used for discovering US home décor retail & wholesale businesses
# Get key: https://console.cloud.google.com/apis/credentials (Enable Places API (New))
GOOGLE_PLACES_API_KEY=

# Hunter.io API - Used for domain-based email discovery and confidence scoring
# Get key: https://hunter.io/api_keys
HUNTER_API_KEY=

# Resend API - Used for sending test emails and verified outreach
# Get key: https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender address in Resend (e.g. 'onboarding@resend.dev' for sandbox, or your custom domain 'export@yourdomain.com')
EMAIL_FROM=

# Recipient email address for system test verification (/api/emails/test)
TEST_EMAIL_TO=
